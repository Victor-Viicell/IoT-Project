    ["esp:25", "relay1:IN", "orange", ["v-100", "h-60"]],
    ["esp:26", "relay2:IN", "orange", ["v-100", "h-60"]],
    ["esp:27", "buz1:1", "yellow", ["v-90"]],

    ["esp:16", "rgb1:R", "red", ["v-70"]],
    ["esp:17", "rgb1:G", "green", ["v-70"]],
    ["esp:12", "rgb1:B", "blue", ["v-70"]],

    ["esp:13", "ledg:A", "green", ["v-90"]],
    ["esp:14", "ledr:A", "red", ["v-90"]],

    ["esp:32", "sw1:1.l", "white", ["v-30"]],
    ["esp:33", "sw2:1.l", "white", ["v-30"]],

    ["ledp:C", "relay1:NO", "red", []],
