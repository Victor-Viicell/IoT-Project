    { "type": "wokwi-potentiometer", "id": "soil1", "top": -50, "left": 500,
      "attrs": { "value": "620" } },
    { "type": "wokwi-photoresistor-sensor", "id": "light1", "top": -350, "left": 900,
      "attrs": { "lux": "600", "threshold": "2.5" } },

    { "type": "wokwi-relay-module", "id": "relay1", "top": -800, "left": -550, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay2", "top": -550, "left": -550, "attrs": {} },
    { "type": "wokwi-led", "id": "ledp", "top": -790, "left": -200,
      "attrs": { "color": "red", "label": "BOMBA" } },
    { "type": "wokwi-led", "id": "ledl", "top": -540, "left": -200,
      "attrs": { "color": "yellow", "label": "LAMPADA" } },

    { "type": "wokwi-led", "id": "ledg", "top": 100, "left": 900,
