{
  "version": 1,
  "author": "IoT Project",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },

    { "type": "wokwi-lcd1602", "id": "lcd1", "top": -1100, "left": -1050,
