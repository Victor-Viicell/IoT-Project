"""MicroPython `time` surface for editor type checking only.

MicroPython adds sleep_ms/sleep_us/ticks_* on top of the CPython names. The
board uses its built-in module; this stub only teaches Pyright about it.
"""

def sleep(seconds: float) -> None: ...
def sleep_ms(ms: int) -> None: ...
def sleep_us(us: int) -> None: ...
def time() -> int: ...
def ticks_ms() -> int: ...
def ticks_us() -> int: ...
def ticks_cpu() -> int: ...
def ticks_add(ticks: int, delta: int) -> int: ...
def ticks_diff(ticks1: int, ticks2: int) -> int: ...
def localtime(secs: int | None = None) -> tuple[int, ...]: ...
def gmtime(secs: int | None = None) -> tuple[int, ...]: ...
def mktime(t: tuple[int, ...]) -> int: ...
