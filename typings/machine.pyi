"""Minimal MicroPython ESP32 stubs for editor type checking only.

These files are never executed by the board. They describe just the surface the
firmware uses so Pyright can resolve `machine` and friends.
"""

from typing import Any

class Pin:
    IN: int
    OUT: int
    OPEN_DRAIN: int
    PULL_UP: int
    PULL_DOWN: int
    IRQ_RISING: int
    IRQ_FALLING: int

    def __init__(
        self,
        id: int | str,
        mode: int = ...,
        pull: int = ...,
        *,
        value: int | None = ...,
        drive: int = ...,
        alt: int = ...,
    ) -> None: ...
    def value(self, value: int | None = None) -> int: ...
    def on(self) -> None: ...
    def off(self) -> None: ...
    def irq(self, handler: Any = None, trigger: int = ...) -> Any: ...

class ADC:
    ATTN_0DB: int
    ATTN_2_5DB: int
    ATTN_6DB: int
    ATTN_11DB: int
    WIDTH_9BIT: int
    WIDTH_10BIT: int
    WIDTH_11BIT: int
    WIDTH_12BIT: int

    def __init__(self, pin: Pin) -> None: ...
    def atten(self, atten: int) -> None: ...
    def width(self, width: int) -> None: ...
    def read(self) -> int: ...
    def read_u16(self) -> int: ...

class I2C:
    def __init__(
        self,
        id: int,
        *,
        scl: Pin | None = ...,
        sda: Pin | None = ...,
        freq: int = ...,
        timeout: int = ...,
    ) -> None: ...
    def init(self, *, scl: Pin | None = ..., sda: Pin | None = ..., freq: int = ...) -> None: ...
    def scan(self) -> list[int]: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    def readfrom(self, addr: int, nbytes: int, stop: bool = True) -> bytes: ...
    def readfrom_mem(self, addr: int, memaddr: int, nbytes: int, *, addrsize: int = 8) -> bytes: ...
    def writeto(self, addr: int, buf: bytes, stop: bool = True) -> int: ...
    def writeto_mem(self, addr: int, memaddr: int, buf: bytes, *, addrsize: int = 8) -> None: ...
    def writevto(self, addr: int, vector: tuple[bytes, ...], stop: bool = True) -> int: ...

class Timer:
    ONE_SHOT: int
    PERIODIC: int

    def __init__(self, id: int, **kwargs: Any) -> None: ...
    def init(self, **kwargs: Any) -> None: ...
    def deinit(self) -> None: ...

class Signal:
    def __init__(self, pin: Pin, invert: bool = False) -> None: ...
    def value(self, value: int | None = None) -> int: ...
    def on(self) -> None: ...
    def off(self) -> None: ...
